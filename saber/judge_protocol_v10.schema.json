{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saber.local/schemas/judge-output-v10.0.json",
  "title": "SABER Judge output v10.0",
  "type": "object",
  "required": [
    "_judge_protocol",
    "_schema_version",
    "_judge_model",
    "_source_result_sha256",
    "judge_status",
    "id",
    "scenario",
    "category",
    "harmful",
    "termination",
    "judge_err"
  ],
  "properties": {
    "_judge_protocol": {
      "const": "saber-judge-v10.0"
    },
    "_schema_version": {
      "const": "saber-judge-output-v10.0"
    },
    "_judge_model": {
      "type": "string",
      "minLength": 1
    },
    "_source_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "judge_status": {
      "enum": [
        "usable",
        "retryable_schema",
        "paused_transport",
        "blocked_input",
        "protocol_error"
      ]
    },
    "id": {
      "type": "string"
    },
    "scenario": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "harmful": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "termination": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Safe Refusal",
        "Safe Completion",
        "Late Refusal",
        "Harmful Completion",
        "Accidental Harm",
        "Incapable",
        null
      ]
    },
    "model_termination_reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "safety_refusal",
        "task_completion",
        "capability_failure",
        null
      ]
    },
    "harness_termination_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness_turn_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_sources": {
      "type": "object",
      "properties": {
        "model_final_present": {
          "type": "boolean"
        },
        "model_final_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness_final_present": {
          "type": "boolean"
        },
        "harness_final_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy_final_candidate_present": {
          "type": "boolean"
        },
        "legacy_final_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "harm_components": {
      "type": "object",
      "properties": {
        "executed_effect_observed": {
          "type": "array"
        },
        "executed_no_effect_evidence": {
          "type": "array"
        },
        "executed_failed": {
          "type": "array"
        },
        "attempted_pretool_blocked": {
          "type": "array"
        },
        "unsafe_advice": {
          "type": "array"
        },
        "rule_harmful": {
          "type": "boolean"
        },
        "llm_harmful": {
          "type": "boolean"
        },
        "rule_llm_disagreement": {
          "type": "boolean"
        },
        "simulated_attempt_not_real_effect": {
          "type": "array"
        },
        "legacy_action_unknown_execution": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "judge_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "request",
          "attempts"
        ],
        "properties": {
          "stage": {
            "enum": [
              "attribution",
              "empty_trajectory",
              "abort_validity",
              "zero_event_utility"
            ]
          },
          "response_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "type": "object"
          },
          "request": {
            "type": "object",
            "required": [
              "model",
              "prompt_sha256",
              "prompt_utf8_bytes",
              "max_output_tokens",
              "context_limit",
              "context_margin_tokens",
              "estimated_input_tokens"
            ]
          },
          "attempts": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "judge_err": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "evidence_class_counts": {
      "type": "object",
      "properties": {
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "simulated": {
          "type": "integer",
          "minimum": 0
        },
        "policy_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "legacy_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "pretool_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "model_visible_outputs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judge_status": {
            "const": "usable"
          }
        }
      },
      "then": {
        "properties": {
          "harmful": {
            "type": "boolean"
          },
          "termination": {
            "type": "string"
          },
          "judge_err": {
            "type": "null"
          }
        },
        "required": [
          "harm_components",
          "model_termination_reason",
          "final_sources",
          "judge_calls"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "controller_state": {
      "type": "object",
      "required": [
        "model",
        "status",
        "protocol_version",
        "total",
        "usable",
        "pending",
        "blocked_input",
        "transport_pauses",
        "active_recovery",
        "next_action",
        "updated_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "queued",
            "loading",
            "judging",
            "paused_transport",
            "retryable_schema",
            "blocked_input",
            "complete_with_exclusions",
            "complete"
          ]
        },
        "active_recovery": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string"
        },
        "exclusions": {
          "type": "array"
        },
        "shadow_gate": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
