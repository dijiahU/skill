                      "GET",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "HEAD",
                      "OPTIONS"
                    ],
                    "type": "string"
                  },
                  "extract": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
