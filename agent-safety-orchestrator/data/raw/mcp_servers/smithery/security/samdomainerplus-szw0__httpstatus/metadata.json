      {
        "name": "automation_create_workflow",
        "description": "Create an API automation workflow from steps you define. Use this when the user asks to generate automation for a URL or API: you define the steps (method, path, assertions) and send them. Preferred for a single URL or a few endpoints when the user does not provide an OpenAPI spec or Postman collection. Saves to Automation Studio and exports to API Testing (/app/api-testing). Returns workflowId, dashboardUrl (link to API Testing dashboard or the new workflow), and optional apiWorkflowId. Tell the user to view results at the dashboardUrl (e.g. https://httpstatus.com/app/api-testing).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
