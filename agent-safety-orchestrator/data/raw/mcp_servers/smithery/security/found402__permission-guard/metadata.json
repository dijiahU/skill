                  },
                  "resource": {
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "warning",
                      "denied"
                    ],
                    "type": "string"
                  }
                }
              },
              "description": "List of violations found"
            },
            "checked_action": {
              "type": "string"
            },
            "checked_resource": {
              "type": "string"
            }
          }
        }
      }
