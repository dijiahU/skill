    "tools": [
      {
        "name": "atkn_trust_score",
        "description": "Compute trust score for an agent using 6-dimensional reputation analysis",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "Unique identifier of the agent to score"
            },
            "include_history": {
              "type": "boolean",
              "description": "Include recent outcome history"
            }
          }
        }
      },
      {
        "name": "atkn_verify_agent",
        "description": "Full Gabbay argumentation-based agent verification with circuit breaker check",
        "inputSchema": {
          "type": "object",
          "properties": {
            "depth": {
              "enum": [
                "basic",
                "standard",
                "deep"
              ],
              "type": "string",
              "description": "Verification depth level"
            },
            "agent_id": {
              "type": "string",
              "description": "Agent to verify"
            }
          }
        }
      },
      {
        "name": "atkn_certify_agent",
        "description": "Complete Gabbay analysis + on-chain ERC-721 trust certification on Base",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "Agent to certify"
            },
            "wallet_address": {
              "type": "string",
              "description": "Wallet address for certificate"
            }
          }
        }
      },
      {
        "name": "atkn_register_agent",
        "description": "Register agent in ATKN with wallet-linked profile and initial trust score",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Human-readable name"
            },
            "agent_id": {
              "type": "string",
              "description": "Unique identifier for the agent"
            },
            "category": {
              "enum": [
                "infrastructure_ops",
                "ai_services",
                "development",
                "orchestration",
                "research",
                "monitoring"
              ],
              "type": "string",
              "description": "Classification category for the agent"
            },
            "description": {
              "type": "string",
              "description": "Agent description"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of capabilities"
            },
            "wallet_address": {
              "type": "string",
              "description": "Wallet address on Base"
            }
          }
        }
      },
      {
        "name": "atkn_query_knowledge",
        "description": "Query the knowledge graph (3,012+ nodes, 1,391 academic papers)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "number",
              "description": "Maximum number of results"
            },
            "query": {
              "type": "string",
              "description": "Natural language or CYPHER query"
            }
          }
        }
      },
      {
        "name": "atkn_behavioral_score",
        "description": "KosherNinja 10-category behavioral scoring analysis",
        "inputSchema": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "description": "Optional scoring context"
            },
            "agent_id": {
              "type": "string",
              "description": "Agent to score behaviorally"
            }
          }
        }
      },
      {
