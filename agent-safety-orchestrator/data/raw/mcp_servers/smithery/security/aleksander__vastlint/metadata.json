                  "description",
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "rule_id": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            "remaining": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "severity",
                  "message",
                  "spec_ref"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "spec_ref": {
                    "type": "string"
                  }
                }
              }
            },
            "applied_count": {
              "type": "integer"
            },
            "remaining_count": {
              "type": "integer"
            }
          },
          "required": [
            "xml",
            "applied_count",
            "remaining_count",
            "applied",
            "remaining"
          ]
        }
