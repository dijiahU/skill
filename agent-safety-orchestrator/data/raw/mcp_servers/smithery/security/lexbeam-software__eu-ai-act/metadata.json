      {
        "name": "euaiact_check_gpai_systemic_risk",
        "description": "Determine whether a general-purpose AI model qualifies as a GPAI model with systemic risk under Art. 51. A model is presumed to have high-impact capabilities when cumulative training compute exceeds 10^25 FLOPs (Art. 51(2)). The Commission may also designate models with equivalent capabilities or impact under Art. 51(1)(b). Returns baseline GPAI obligations under Art. 53 plus systemic-risk-only obligations under Art. 55, and the Art. 52 notification duty.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "model_name": {
              "type": "string",
              "description": "Optional model name for traceability in the response."
            },
            "training_flops": {
              "type": "number",
              "description": "Cumulative training compute in FLOPs (e.g. 2e25). Art. 51(2) presumes systemic risk when > 1e25."
            },
            "commission_designated": {
              "type": "boolean",
              "description": "Whether the Commission has formally designated the model as GPAI with systemic risk under Art. 51(1)(b)."
            }
          }
        },
