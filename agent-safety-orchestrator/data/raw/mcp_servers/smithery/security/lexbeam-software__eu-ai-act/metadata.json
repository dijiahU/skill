          "type": "object",
          "properties": {
            "is_sme": {
              "type": "boolean",
              "default": false,
              "description": "Whether the entity is an SME or startup (eligible for lower fines under Art. 99(6))"
            },
            "violation_type": {
              "enum": [
                "prohibited",
                "high_risk",
                "false_info"
              ],
              "type": "string",
              "description": "Type of AI Act violation: 'prohibited' (Art. 5), 'high_risk' (Annex III obligations), or 'false_info' (misleading regulators)"
            },
            "annual_turnover_eur": {
