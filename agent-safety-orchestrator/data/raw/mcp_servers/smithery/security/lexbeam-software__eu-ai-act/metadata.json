      {
        "name": "euaiact_classify_system",
        "description": "Classify an AI system's risk level under the EU AI Act (Regulation 2024/1689). Accepts a free-text description, a use_case, and/or structured signals (domain, biometric flags, synthetic content, etc.). Signals take precedence over text matching for deterministic classification. Returns risk classification, applicable Annex III category, relevant articles, provider/deployer determination, matched signals, and follow-up questions the agent should relay. Note: Art. 6(3) exceptions require documented justification and cannot be auto-applied; use euaiact_assess_art6_3_exception.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "provider",
                "deployer",
                "unknown"
              ],
              "type": "string",
              "default": "unknown"
            },
            "signals": {
              "type": "object",
              "properties": {
                "domain": {
                  "enum": [
                    "employment",
                    "education",
                    "biometrics",
                    "critical_infrastructure",
                    "law_enforcement",
                    "migration",
                    "justice",
                    "essential_services",
                    "health",
                    "gpai",
                    "product_safety",
                    "other"
                  ],
                  "type": "string",
                  "description": "Primary sector where the system operates"
                },
                "uses_biometrics": {
                  "type": "boolean",
                  "description": "System processes biometric data (face, fingerprint, iris, voice, gait)"
                },
                "biometric_realtime": {
                  "type": "boolean",
                  "description": "Biometric processing happens in real time"
                },
                "biometric_law_enforcement": {
                  "type": "boolean",
                  "description": "Biometric system is used by or for law enforcement"
                },
                "affects_fundamental_rights": {
                  "type": "boolean",
                  "description": "System materially affects health, safety, or fundamental rights of natural persons"
                },
                "generates_synthetic_content": {
                  "type": "boolean",
                  "description": "System generates or manipulates images, audio, video, or text (Art. 50(2)/(4))"
                },
                "interacts_with_natural_persons": {
                  "type": "boolean",
                  "description": "System is designed to interact directly with natural persons (Art. 50(1))"
                },
                "targets_children_or_vulnerable": {
                  "type": "boolean",
                  "description": "System is directed at or materially affects children or other vulnerable groups (Art. 5(1)(b))"
                },
                "is_safety_component_of_regulated_product": {
                  "type": "boolean",
                  "description": "System is a safety component of a product covered by EU harmonisation legislation (Annex I)"
                },
                "performs_social_scoring_by_public_authority": {
                  "type": "boolean",
                  "description": "System is used by or on behalf of a public authority to score natural persons (Art. 5(1)(c))"
                },
                "performs_emotion_recognition_workplace_or_school": {
                  "type": "boolean",
                  "description": "System infers emotions of natural persons in the workplace or educational institutions (Art. 5(1)(f))"
                }
              },
              "additionalProperties": false
            },
            "use_case": {
              "type": "string",
              "description": "Specific context where the system is deployed"
            },
            "description": {
              "type": "string",
              "description": "Free-text description of the AI system and its functionalities"
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "basis": {
              "enum": [
                "signals",
                "text",
                "default"
              ],
              "type": "string"
            },
