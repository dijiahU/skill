        "TOOL_RETRY_DELAY_SECONDS": {
          "description": "Delay between retry attempts in seconds (default: 1.0)",
          "type": "string",
          "default": "1.0"
        },
        "OAUTH_RESOURCE_SERVER_URL": {
          "description": "Resource server identification URL (e.g., https://your-mcp-server.com)",
          "type": "string"
        }
      },
