          "description": "Enable OAuth authentication (true/false)",
          "type": "string"
        },
        "KEYCLOAK_REALM": {
          "description": "Keycloak realm name (e.g., teradata-realm)",
          "type": "string"
        },
        "KEYCLOAK_CLIENT_ID": {
          "description": "Keycloak client ID (e.g., teradata-mcp)",
          "type": "string"
        },
        "OAUTH_REQUIRE_HTTPS": {
          "description": "Require HTTPS for OAuth endpoints (true/false)",
          "type": "string"
        },
        "OAUTH_REQUIRED_SCOPES": {
          "description": "Optional: Required scopes (comma-separated, e.g., teradata:read,teradata:query)",
          "type": "string"
        },
        "OAUTH_VALIDATE_SCOPES": {
          "description": "Whether to validate token scopes (true/false)",
          "type": "string"
        },
        "KEYCLOAK_CLIENT_SECRET": {
          "description": "Keycloak client secret",
          "type": "string"
        },
        "OAUTH_VALIDATE_AUDIENCE": {
          "description": "Whether to validate token audience (true/false)",
