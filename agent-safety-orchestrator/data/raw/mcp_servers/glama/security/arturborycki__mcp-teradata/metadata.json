    "description": "Enables secure interaction with Teradata databases through SQL queries, schema exploration, and business intelligence analysis with enterprise-grade OAuth 2.1 authentication and workload management capabilities.",
    "environmentVariablesJsonSchema": {
      "properties": {
        "MCP_HOST": {
          "description": "Host address for MCP server (e.g., 0.0.0.0)",
          "type": "string"
        },
        "MCP_PATH": {
          "description": "Path for MCP server when using streamable-http transport (e.g., /mcp/)",
          "type": "string"
        },
        "MCP_PORT": {
          "description": "Port number for MCP server (e.g., 8000)",
          "type": "string"
        },
        "LOG_LEVEL": {
          "description": "Logging level (e.g., DEBUG, INFO, WARNING, ERROR)",
          "type": "string"
        },
        "DATABASE_URI": {
          "description": "Database connection URI in format: teradatasql://username:password@hostname/database",
          "type": "string"
        },
        "KEYCLOAK_URL": {
          "description": "Keycloak server URL (e.g., https://keycloak.example.com)",
          "type": "string"
        },
        "MCP_TRANSPORT": {
          "description": "MCP transport method (sse, streamable-http, or stdio)",
          "type": "string"
        },
