{
  "registry": "glama",
  "id": "ior2jxeeij",
  "namespace": "derricksiawor",
  "slug": "mav-postgresql-mcp-server",
  "name": "PostgreSQL MCP Server",
  "description": "Provides comprehensive PostgreSQL database access with 36 tools for querying, managing schemas, JSONB operations, and database administration. Includes security features like query validation, rate limiting, SSL/TLS support, and optional write operations.",
  "discoveryQueries": [
    "security"
  ],
  "rawRecord": {
    "attributes": [
      "hosting:remote-capable"
    ],
    "description": "Provides comprehensive PostgreSQL database access with 36 tools for querying, managing schemas, JSONB operations, and database administration. Includes security features like query validation, rate limiting, SSL/TLS support, and optional write operations.",
    "environmentVariablesJsonSchema": {
      "properties": {
        "PG_HOST": {
          "description": "PostgreSQL server hostname",
          "type": "string",
          "default": "localhost"
        },
        "PG_PORT": {
          "description": "PostgreSQL server port",
          "type": "string",
          "default": "5432"
        },
        "PG_USER": {
          "description": "Database username",
          "type": "string",
          "default": "postgres"
        },
        "PG_SCHEMA": {
          "description": "Default schema",
          "type": "string",
          "default": "public"
        },
        "MAX_RESULTS": {
          "description": "Maximum rows returned",
          "type": "string",
          "default": "1000"
        },
        "PG_DATABASE": {
          "description": "Target database name",
          "type": "string"
        },
        "PG_PASSWORD": {
          "description": "Database password",
          "type": "string"
        },
        "PG_SSL_MODE": {
          "description": "SSL connection mode (disable, require, verify-ca, verify-full)",
          "type": "string"
        },
        "QUERY_TIMEOUT": {
          "description": "Query timeout in milliseconds",
          "type": "string",
          "default": "30000"
        },
        "PG_SSL_CA_PATH": {
          "description": "Path to CA certificate",
          "type": "string"
        },
        "PG_SSL_KEY_PATH": {
          "description": "Path to client key",
          "type": "string"
        },
        "CONNECTION_LIMIT": {
          "description": "Maximum pool connections",
          "type": "string",
          "default": "10"
        },
        "PG_SSL_CERT_PATH": {
          "description": "Path to client certificate",
          "type": "string"
        },
        "PG_SSL_MIN_VERSION": {
          "description": "Minimum TLS version (TLSv1.2, TLSv1.3)",
          "type": "string"
        },
        "RATE_LIMIT_PER_HOUR": {
          "description": "Queries per hour",
          "type": "string",
          "default": "1000"
        },
        "RATE_LIMIT_CONCURRENT": {
          "description": "Concurrent queries",
          "type": "string",
          "default": "10"
        },
        "RATE_LIMIT_PER_MINUTE": {
          "description": "Queries per minute",
          "type": "string",
          "default": "60"
        },
        "ALLOW_WRITE_OPERATIONS": {
          "description": "Enable INSERT/UPDATE/DELETE operations",
          "type": "string",
          "default": "false"
        },
        "PG_SSL_REJECT_UNAUTHORIZED": {
          "description": "Reject self-signed certs (true, false)",
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "PG_PASSWORD",
        "PG_DATABASE"
      ]
    },
    "id": "ior2jxeeij",
    "name": "PostgreSQL MCP Server",
    "namespace": "derricksiawor",
    "repository": {
      "url": "https://github.com/derricksiawor/mav-postgresql-mcp-server"
    },
    "slug": "mav-postgresql-mcp-server",
    "spdxLicense": {
      "name": "MIT License",
      "url": "https://spdx.org/licenses/MIT.json"
    },
    "tools": [],
    "url": "https://glama.ai/mcp/servers/ior2jxeeij"
  }
}
