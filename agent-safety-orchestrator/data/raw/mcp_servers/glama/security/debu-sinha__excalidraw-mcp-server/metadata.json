{
  "registry": "glama",
  "id": "ldewiifrfj",
  "namespace": "debu-sinha",
  "slug": "excalidraw-mcp-server",
  "name": "excalidraw-mcp-server",
  "description": "Security-hardened MCP server for Excalidraw with API key auth, rate limiting, real-time WebSocket sync, and 14 diagramming tools",
  "discoveryQueries": [
    "security"
  ],
  "rawRecord": {
    "attributes": [
      "hosting:hybrid"
    ],
    "description": "Security-hardened MCP server for Excalidraw with API key auth, rate limiting, real-time WebSocket sync, and 14 diagramming tools",
    "environmentVariablesJsonSchema": {
      "properties": {
        "LOG_LEVEL": {
          "description": "Log level: debug, info, warn, error",
          "type": "string",
          "default": "info"
        },
        "CANVAS_HOST": {
          "description": "Canvas server bind address",
          "type": "string",
          "default": "127.0.0.1"
        },
        "CANVAS_PORT": {
          "description": "Canvas server port",
          "type": "string",
          "default": "3000"
        },
        "MAX_ELEMENTS": {
          "description": "Maximum elements on canvas",
          "type": "string",
          "default": "10000"
        },
        "MAX_BATCH_SIZE": {
          "description": "Maximum elements per batch create",
          "type": "string",
          "default": "100"
        },
        "PERSISTENCE_DIR": {
          "description": "Directory for persistent storage",
          "type": "string",
          "default": "./data"
        },
        "STANDALONE_MODE": {
          "description": "Use in-process store (no canvas server needed)",
          "type": "string",
          "default": "true"
        },
        "AUDIT_LOG_ENABLED": {
          "description": "Enable audit logging",
          "type": "string",
          "default": "true"
        },
        "CANVAS_SERVER_URL": {
          "description": "URL the MCP server uses to reach the canvas. Required for connected mode.",
          "type": "string",
          "default": "http://127.0.0.1:3000"
        },
        "EXCALIDRAW_API_KEY": {
          "description": "API key for auth (min 32 chars). Required for connected mode.",
          "type": "string"
        },
        "PERSISTENCE_ENABLED": {
          "description": "Enable file-based persistence",
          "type": "string",
          "default": "false"
        },
        "CORS_ALLOWED_ORIGINS": {
          "description": "Comma-separated origin allowlist",
          "type": "string",
          "default": "http://localhost:3000,http://127.0.0.1:3000"
        },
        "RATE_LIMIT_WINDOW_MS": {
          "description": "Rate limit window in milliseconds",
          "type": "string",
          "default": "60000"
        },
        "RATE_LIMIT_MAX_REQUESTS": {
          "description": "Max requests per window (standard tier)",
          "type": "string",
          "default": "100"
        }
      },
      "type": "object",
      "required": []
    },
    "id": "ldewiifrfj",
    "name": "excalidraw-mcp-server",
    "namespace": "debu-sinha",
    "repository": {
      "url": "https://github.com/debu-sinha/excalidraw-mcp-server"
    },
    "slug": "excalidraw-mcp-server",
    "spdxLicense": {
      "name": "MIT License",
      "url": "https://spdx.org/licenses/MIT.json"
    },
    "tools": [],
    "url": "https://glama.ai/mcp/servers/ldewiifrfj"
  }
}
