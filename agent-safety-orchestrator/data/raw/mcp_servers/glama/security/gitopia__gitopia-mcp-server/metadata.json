  "description": "Decentralized Git with on-chain governance, bounties, and DAOs.  Tools for repos, issues, PRs, labels, releases, bounties, and DAO proposals.\nAuto-wallet on first use, trust tiers, and approval mode for human-in-the-loop.",
  "discoveryQueries": [
    "trust",
    "supply chain"
  ],
  "rawRecord": {
    "attributes": [
