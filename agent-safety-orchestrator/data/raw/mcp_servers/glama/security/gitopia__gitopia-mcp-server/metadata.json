    "description": "Decentralized Git with on-chain governance, bounties, and DAOs.  Tools for repos, issues, PRs, labels, releases, bounties, and DAO proposals.\nAuto-wallet on first use, trust tiers, and approval mode for human-in-the-loop.",
    "environmentVariablesJsonSchema": {
      "properties": {
        "PORT": {
          "description": "HTTP listen port (when TRANSPORT=http)",
          "type": "string",
          "default": "8080"
        },
        "DRY_RUN": {
          "description": "Preview transactions without broadcasting",
          "type": "string",
          "default": "false"
        },
        "TOOLSETS": {
          "description": "Comma-separated toolsets to enable",
          "type": "string",
          "default": "all"
        },
        "TRANSPORT": {
          "description": "Transport type: stdio or http",
          "type": "string",
          "default": "stdio"
        },
        "TRUST_LEVEL": {
          "description": "Trust level: readonly, localwrite, chainwrite",
          "type": "string",
          "default": "chainwrite"
        },
        "APPROVAL_MODE": {
          "description": "Require confirmation before chain writes",
          "type": "string",
          "default": "false"
        },
        "MCP_LOG_LEVEL": {
          "description": "Log level",
          "type": "string",
          "default": "info"
        },
        "GITOPIA_MNEMONIC": {
          "description": "BIP-39 wallet mnemonic",
          "type": "string",
          "default": "auto-generated"
        },
        "MCP_WORKSPACE_PATH": {
          "description": "Workspace root",
          "type": "string",
          "default": "~/.mcp/gitopia/workspace"
        },
        "GITOPIA_GRPC_ENDPOINTS": {
          "description": "gRPC endpoints",
          "type": "string",
          "default": "gitopia-grpc.polkachu.com:11390"
        }
      },
