        },
        "OPENCODE_PORT": {
          "description": "opencode callback port, default 19876",
          "type": "string",
          "default": "19876"
        },
        "REQUEST_TIMEOUT_MS": {
          "description": "timeout for Slack and local proxy requests, default 10000",
          "type": "string",
          "default": "10000"
        },
        "OPENCODE_CALLBACK_PATH": {
          "description": "opencode callback path, default /mcp/oauth/callback",
