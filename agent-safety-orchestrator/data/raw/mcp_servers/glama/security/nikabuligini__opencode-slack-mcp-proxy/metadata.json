          "description": "facade host, default 127.0.0.1",
          "type": "string",
          "default": "127.0.0.1"
        },
        "FACADE_PORT": {
          "description": "facade port, default 3120",
          "type": "string",
          "default": "3120"
        },
        "CALLBACK_HOST": {
          "description": "callback listener host, default 127.0.0.1",
          "type": "string",
          "default": "127.0.0.1"
        },
        "CALLBACK_PORT": {
          "description": "callback port, default 3118",
          "type": "string",
          "default": "3118"
        },
        "OPENCODE_HOST": {
