          "type": "string"
        },
        "REDDIT_ACCESS_TOKEN": {
          "description": "Reddit access token for API requests",
          "type": "string"
        },
        "REDDIT_CLIENT_SECRET": {
          "description": "Your Reddit client secret from the Reddit app configuration",
          "type": "string"
        },
