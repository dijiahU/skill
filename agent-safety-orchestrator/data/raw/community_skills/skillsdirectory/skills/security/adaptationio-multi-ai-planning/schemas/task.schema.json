{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "description": "Individual task within an agentic plan",
  "type": "object",
  "required": ["id", "description", "verification", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$",
      "description": "Hierarchical task identifier",
      "examples": ["1", "1.2", "1.2.3"]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Clear, actionable description of the task"
    },
    "level": {
      "enum": ["huge", "large", "medium", "small", "atomic"],
      "description": "Task granularity level for decomposition tracking"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$",
      "description": "Parent task ID (for hierarchical breakdown)"
    },
    "children": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Child task IDs (if this task has been decomposed)"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "type"],
        "properties": {
          "task_id": {"type": "string"},
          "type": {
            "enum": ["hard", "soft"],
            "description": "Hard: must complete, Soft: preferred order"
          },
          "reason": {"type": "string"}
        }
      },
      "description": "Dependencies with type and rationale"
    },
    "agent_suggestion": {
      "type": "string",
      "description": "Suggested agent or skill to handle this task"
    },
    "tools_required": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tools needed for this task",
      "examples": ["write", "read", "bash", "grep"]
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0.1,
      "description": "Estimated effort in hours"
    },
    "estimation_method": {
      "enum": ["historical", "comparison", "three_point", "expert"],
      "description": "How estimate was derived"
    },
    "verification": {
      "type": "object",
      "required": ["success_criteria", "method"],
      "properties": {
        "success_criteria": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "description": "Specific, measurable success conditions"
        },
        "method": {
          "enum": ["automated_test", "manual_check", "visual_inspection", "integration_test", "code_review", "user_acceptance"],
          "description": "Verification approach"
        },
        "commands": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Shell commands for automated verification"
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "description": "Max time for verification"
        },
        "expected_output": {
          "type": "string",
          "description": "Expected verification output or behavior"
        }
      }
    },
    "status": {
      "enum": ["pending", "in_progress", "complete", "failed", "skipped", "blocked"],
      "default": "pending"
    },
    "status_reason": {
      "type": "string",
      "description": "Reason for current status (especially for failed/blocked/skipped)"
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Expected output files or deliverables"
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "completed": {
      "type": "string",
      "format": "date-time"
    },
    "actual_hours": {
      "type": "number",
      "minimum": 0,
      "description": "Actual time spent"
    },
    "notes": {
      "type": "string",
      "description": "Implementation notes, learnings, or issues"
    },
    "failure_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {"type": "string"},
          "handling": {"type": "string"},
          "rollback": {"type": "string"}
        }
      },
      "description": "Expected failure scenarios and handling"
    }
  }
}
