# Project secrets template.
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#     # then edit .env
# Never commit `.env` to git. (See .gitignore.)
#
# Format: KEY=value or KEY="value with spaces"
# Comments start with #. Blank lines OK.
# Shell-exported env vars always win over .env values, so you can still
# override these on a per-command basis if needed.

# DeepSeek — used by scripts/llm_audit_stage1_classify.py for sub-task 1.2/1.3.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-replace-me

# Zhipu AI — used by scripts/dedup_stage3_embedding.py for Stage 3 vector embeddings.
# Get one at https://open.bigmodel.cn/usercenter/apikeys
# NOTE: rotate the previously-leaked key from earlier sessions.
ZHIPU_API_KEY=replace-me
