# Copy to .env. Shell variables override this file. Never commit API keys.
# Use a fixed model ID for paired runs, not a provider's random/free router.
BENCH_MODEL=REPLACE_WITH_MODEL_ID
BENCH_BASE_URL=https://api.openai.com/v1
BENCH_API_KEY=
# SABER and Terminal-Bench use Codex and require streaming Responses + tools.
# These may point at a different provider from the Chat Completions endpoint.
RESPONSES_MODEL=REPLACE_WITH_MODEL_ID
RESPONSES_BASE_URL=https://api.openai.com/v1
RESPONSES_API_KEY=
# SABER semantic judge (openai = Chat Completions; anthropic = Messages).
JUDGE_MODEL=REPLACE_WITH_JUDGE_MODEL_ID
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_TYPE=openai
# OAS NPC simulation always uses Chat Completions; independent of the agent.
NPC_MODEL=REPLACE_WITH_NPC_MODEL_ID
NPC_BASE_URL=https://api.openai.com/v1
NPC_API_KEY=
# OAS agent: openai for OpenAI-compatible providers, anthropic for Messages.
BENCH_PROVIDER=openai
BENCH_MAX_STEPS=30
BENCH_RUN_ID=api-smoke-001
OAS_DATASET=mgulavani/openagentsafety_full_updated_v3
TERMINALBENCH_DATASET=terminal-bench/terminal-bench-2-1
TERMINALBENCH_CONCURRENCY=1
TERMINALBENCH_ATTEMPTS=1
# Optional GLM Chat Completions bridge; RESPONSES_* then specifies the upstream.
# Requires the Harbor Python environment and Docker Desktop host routing.
# TERMINALBENCH_CHAT_BRIDGE=1
# BRIDGE_MAX_OUTPUT_TOKENS=8192
# Optional: use the official archive prepared by setup.sh terminalbench-cli.
# TERMINALBENCH_CODEX_ARCHIVE=/absolute/path/to/api_benchmarks/.cache/codex-0.149.1-linux-x64.tgz
# Optional container-reachable proxy, applied equally to agent and verifier.
# TERMINALBENCH_HTTP_PROXY=http://host.docker.internal:7890
# Reachable from the benchmark controller; services must already be provisioned.
OPENAGENTSAFETY_SERVICE_CONTROL_URL=http://127.0.0.1:2999
OPENAGENTSAFETY_DOCKER_HOST_ADDR=127.0.0.1
# On Docker Desktop, container-to-host service routing uses this hostname.
OPENAGENTSAFETY_SERVICE_HOST_ADDR=host.docker.internal
OPENAGENTSAFETY_IMAGE_TAG_PREFIX=api
# Optional container-reachable proxy for building Linux OAS dependencies.
# OAS_BUILD_HTTP_PROXY=http://host.docker.internal:7890

# Optional provider key aliases. Keep one key per provider, reference it by name:
# SILICONFLOW_API_KEY=
# APINEBULA_API_KEY=
# BENCH_API_KEY_ENV=SILICONFLOW_API_KEY
# JUDGE_API_KEY_ENV=SILICONFLOW_API_KEY
# NPC_API_KEY_ENV=SILICONFLOW_API_KEY
# RESPONSES_API_KEY_ENV=APINEBULA_API_KEY
