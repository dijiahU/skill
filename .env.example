# Safety Orchestrator — optional environment settings
# Hooks read process environment variables; they do not automatically load .env.
# Export selected settings in the environment that starts the host.
# Keep JSON values shell-quoted if sourcing a locally maintained config.

# --- check-malware-hash-ioc ---
# VirusTotal API key. Service limits depend on your account.
# Get a key at https://www.virustotal.com/gui/my-apikey
# Without this key, check-malware-hash-ioc auto-disables (fail-open-warn).
VIRUSTOTAL_API_KEY=

# --- check-dependency-confusion ---
# JSON inventory required for deterministic package-name/version comparison
# against cache-backed public registry metadata.
# Example: {"npm":{"@corp/core":"1.4.0"},"PyPI":{"corp-utils":"2.0.0"}}
SAFETY_ORCH_INTERNAL_PACKAGES_JSON=

# --- check-package-recency-anomaly ---
# Warn when a registry package was first published fewer than this many days ago.
SAFETY_ORCH_PACKAGE_MIN_AGE_DAYS=30

# --- evaluate-content-moderation-rule ---
# Optional deployer rule pack. Use either inline JSON or a JSON file containing
# an object of {"rule-id": "regex"}. No product policy is enabled implicitly.
SAFETY_ORCH_MODERATION_RULES_JSON=
SAFETY_ORCH_MODERATION_RULES_FILE=

# --- evaluate-opa-rego-rule ---
# When a policy path is configured, every planned tool call is sent to `opa eval`
# as JSON input. Missing/invalid OPA defaults to fail-closed.
SAFETY_ORCH_OPA_POLICY_PATH=
SAFETY_ORCH_OPA_QUERY=data.safety.allow
SAFETY_ORCH_OPA_BINARY=
SAFETY_ORCH_OPA_FAIL_POLICY=fail-closed

# --- verify-resource-namespace-scope ---
# Optional JSON map from tool name (or "*") to allowed typed resource patterns.
# A trailing * is a prefix match. Relative file paths resolve against event cwd.
# Example: {"Write":["file:/srv/workspace/*"],"database_query":["schema:analytics"]}
SAFETY_ORCH_RESOURCE_NAMESPACES_JSON=

# Dynamic MCP/tool names that clearly send a raw/full/sensitive payload are
# blocked locally. Ambiguous broad MCP operations warn by default; set this to
# 1 to make those warnings fail closed until an explicit scoped path is used.
SAFETY_ORCH_STRICT_SCOPE_GUARD=0

# Comma-separated tool names whose status output is an independently trusted
# source of MCP approval/attestation. Caller-supplied approved=true fields and
# approval text from all other tools never grant authority; hold states still
# fail safe. Example: mcp_policy_read_review_status
SAFETY_ORCH_MCP_APPROVAL_SOURCE_TOOLS=

# --- deployer-configured trust policies ---
# Skill name (or "*") -> {"sha256": "expected digest"}.
# Unconfigured entries are not verified by this check.
SAFETY_ORCH_SKILL_SIGNATURE_POLICY_JSON=
# Server/tool name (or "*") -> list of permitted publisher names.
SAFETY_ORCH_PUBLISHER_ALLOWLIST_JSON=

# --- cache layer (cache_snapshot.py) ---
# Cache directory. Defaults to ~/.cache/safety-orch/ if unset.
SAFETY_ORCH_CACHE_DIR=

# Path to a prebuilt indexed OSV JSON snapshot. Expected top-level keys are
# "ecosystem|package" and values are advisory lists with affected_versions.
# Used only when explicitly running helpers.cache_snapshot refresh-db.
SAFETY_ORCH_OSV_SNAPSHOT_SOURCE=

# Maximum age (days) for the imported OSV snapshot before health_status
# marks check-package-cve as "stale-degraded" even when online.
# Default 14.
SAFETY_ORCH_SNAPSHOT_MAX_AGE_DAYS=14

# --- Tier 2 (air-gap) — override default public endpoints ---
# Override osv.dev endpoint to internal mirror.
OSV_ENDPOINT=https://api.osv.dev/v1
# Override npm registry endpoint.
NPM_REGISTRY_ENDPOINT=https://registry.npmjs.org
# Override pypi registry endpoint.
PYPI_REGISTRY_ENDPOINT=https://pypi.org/pypi

# --- unavailable CVE data and recovery ---
# warn or block. Known vulnerabilities at the threshold still block.
SAFETY_ORCH_CVE_UNAVAILABLE_POLICY=warn
SAFETY_ORCH_CVE_BLOCK_CVSS=7.0
# Accept unavailable CVE data under the block policy; never overrides a CVE hit.
SAFETY_ORCH_ACCEPT_DEGRADED=0
# Codex recovery: recheck each action, or allow bounded read-only diagnostics.
SAFETY_ORCH_RECOVERY_POLICY=recheck
SAFETY_ORCH_MAX_RECOVERY_ACTIONS=4
# Fail closed on internal Codex bridge errors.
SAFETY_ORCH_FAIL_CLOSED=0
# Audit and health state directory. Defaults to ~/.safety-orch.
SAFETY_ORCH_STATUS_DIR=
